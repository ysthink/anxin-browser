<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      窗口底色用品牌深色启动图，避免首帧前露出浅色底造成白闪。
      Compose 起来后由 MainActivity 按用户夜间设置改写为纯色。
    -->
    <style name="Theme.AnxinBrowser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
